{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/prep/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/prep/fonts/:path*",
      "destination": "/fonts/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
